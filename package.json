{
  "name": "the-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:link": "yalc link @joisse1101/ui-library && npm run dev:force",
    "dev:update": "yalc update @joisse1101/ui-library && npm run dev:force",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "build:unlink": "yalc retreat @joisse1101/ui-library && npm update @joisse1101/ui-library && npm install && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@joisse1101/ui-library": "^1.5.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass-embedded": "^1.106.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
